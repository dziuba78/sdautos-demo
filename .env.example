# Przykładowe zmienne środowiskowe SDAUTOS
# Skopiuj do .env i uzupełnij. NIE commituj pliku .env.

# Adres bazowy witryny (bez końcowego ukośnika)
APP_BASE_URL=http://localhost:8000

# Tryb: demo | production
APP_ENV=demo

# Formularz kontaktowy — w demo wysyłka jest wyłączona
CONTACT_MAIL_ENABLED=false
CONTACT_MAIL_TO=
CONTACT_MAIL_FROM=

# Przyszła integracja PrestaShop 9 (nie używane w demo)
# PRESTASHOP_API_URL=
# PRESTASHOP_API_KEY=
